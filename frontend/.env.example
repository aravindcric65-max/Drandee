# Drandee Frontend Environment Variables
# Copy this file to .env.local for local development.
# Never commit .env.local — it is .gitignored.
#
# For Vercel deployment, set these in the Vercel project dashboard
# under Settings → Environment Variables.

# ── API ─────────────────────────────────────────────────────────────────────
# URL of the Drandee backend.
# Local dev: leave unset (defaults to http://localhost:5000)
# Production: set to your Render service URL, e.g. https://drandee.onrender.com
REACT_APP_API_URL=

# ── Firebase (Web App Config) ─────────────────────────────────────────────
# These are the public Firebase SDK keys — safe to include in the browser bundle.
# Find them in the Firebase Console → Project Settings → Your apps.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# ── ImageKit (CDN / Media) ────────────────────────────────────────────────
# Public key only — never include the private key on the frontend.
REACT_APP_IMAGEKIT_PUBLIC_KEY=
REACT_APP_IMAGEKIT_URL_ENDPOINT=
