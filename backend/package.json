{
  "name": "drandee-backend",
  "version": "1.0.0",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "create": "node createTables.js",
    "worker": "node worker/index.js",
    "test:logging": "node scratch/test_phase6_logging.js",
    "loadtest:smoke:feed": "artillery run load-tests/feed.yml -e smoke",
    "loadtest:smoke:events": "artillery run load-tests/events.yml -e smoke",
    "loadtest:smoke:health": "artillery run load-tests/health.yml -e smoke",
    "loadtest:smoke": "npm run loadtest:smoke:health && npm run loadtest:smoke:feed && npm run loadtest:smoke:events",
    "loadtest:load:feed": "artillery run load-tests/feed.yml -e load",
    "loadtest:load:events": "artillery run load-tests/events.yml -e load",
    "loadtest:load:health": "artillery run load-tests/health.yml -e load",
    "loadtest:stress:feed": "artillery run load-tests/feed.yml -e stress",
    "loadtest:stress:events": "artillery run load-tests/events.yml -e stress",
    "loadtest:stress:health": "artillery run load-tests/health.yml -e stress"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.2",
    "content-type": "^1.0.5",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "imagekit": "^6.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "artillery": "^2.0.34",
    "magic-string": "^1.2.3",
    "nodemon": "^3.0.1",
    "proxyquire": "^2.1.3",
    "supertest": "^7.2.2"
  }
}
